{
  "name": "bartlomiejw/nbp-exr",
  "description": "WordPress plugin displaying National Bank of Poland (NBP) table C exchange rates.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/bartlomiejw/nbp-exr",
  "authors": [
    {
      "name": "Bartłomiej Warias",
      "homepage": "https://github.com/bartlomiejw"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "NbpExr\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NbpExr\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@analyse",
      "@test"
    ]
  }
}
