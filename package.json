{
  "name": "nbp-exr",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress plugin displaying National Bank of Poland (NBP) table C exchange rates.",
  "author": "Bartłomiej Warias (https://github.com/bartlomiejw)",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartlomiejw/nbp-exr.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "npm run build && bash bin/build-zip.sh"
  },
  "dependencies": {
    "element-plus": "^2.14.7",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
