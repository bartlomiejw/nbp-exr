#. Plugin Name of the plugin
#: nbp-exr.php
#: includes/Admin/SettingsPage.php:59
#: includes/Admin/SettingsPage.php:60
msgid "NBP Exchange Rates"
msgstr "Kursy walut NBP"

#. Plugin URI of the plugin
#: nbp-exr.php
msgid "https://github.com/bartlomiejw/nbp-exr"
msgstr "https://github.com/bartlomiejw/nbp-exr"

#. Description of the plugin
#: nbp-exr.php
msgid "Displays National Bank of Poland (NBP) table C buy and sell exchange rates with a date picker, via the [nbpexr-vue-app] shortcode."
msgstr "Wyświetla kursy kupna i sprzedaży walut z tabeli C Narodowego Banku Polskiego (NBP) z wyborem daty, za pomocą shortcode'u [nbpexr-vue-app]."

#. Author of the plugin
#: nbp-exr.php
msgid "Bartłomiej Warias"
msgstr "Bartłomiej Warias"

#. Author URI of the plugin
#: nbp-exr.php
msgid "https://github.com/bartlomiejw"
msgstr "https://github.com/bartlomiejw"

#: includes/Admin/SettingsPage.php:99
msgid "Loading…"
msgstr "Ładowanie…"

#: includes/Admin/SettingsPage.php:120
msgid "Save changes"
msgstr "Zapisz zmiany"

#: includes/Admin/SettingsPage.php:121
msgid "Discard changes"
msgstr "Odrzuć zmiany"

#: includes/Admin/SettingsPage.php:122
msgid "Settings saved."
msgstr "Ustawienia zostały zapisane."

#: includes/Admin/SettingsPage.php:123
msgid "Settings could not be saved."
msgstr "Nie udało się zapisać ustawień."

#: includes/Admin/SettingsPage.php:124
msgid "The list of currencies could not be loaded from NBP. Previously selected currencies are still shown."
msgstr "Nie udało się pobrać listy walut z NBP. Wcześniej wybrane waluty są nadal widoczne."

#: includes/Admin/SettingsPage.php:125
msgid "Select currencies"
msgstr "Wybierz waluty"

#: includes/Admin/SettingsPage.php:126
#: includes/Admin/SettingsPage.php:130
#: includes/Frontend/Shortcode.php:88
msgid "Exchange rates"
msgstr "Kursy walut"

#: includes/Admin/SettingsPage.php:127
msgid "Usage"
msgstr "Użycie"

#: includes/Admin/SettingsPage.php:128
msgid "Paste the shortcode into any post, page or Shortcode block. Optional attributes override the settings for a single table."
msgstr "Wklej shortcode do dowolnego wpisu, strony lub bloku Shortcode. Opcjonalne atrybuty nadpisują ustawienia dla pojedynczej tabeli."

#: includes/Api/RatesController.php:52
msgid "Date in YYYY-MM-DD format. Defaults to the latest table."
msgstr "Data w formacie RRRR-MM-DD. Domyślnie najnowsza tabela."

#: includes/Api/SettingController.php:75
msgid "Sorry, you are not allowed to manage these settings."
msgstr "Nie masz uprawnień do zarządzania tymi ustawieniami."

#: includes/Frontend/Shortcode.php:69
msgid "NBP Exchange Rates: front-end assets are missing. Run \"npm run build\"."
msgstr "Kursy walut NBP: brak zbudowanych plików front-endu. Uruchom \"npm run build\"."

#: includes/Frontend/Shortcode.php:106
msgid "Currency"
msgstr "Waluta"

#: includes/Frontend/Shortcode.php:107
msgid "Buy rate"
msgstr "Kurs kupna"

#: includes/Frontend/Shortcode.php:108
msgid "Sell rate"
msgstr "Kurs sprzedaży"

#: includes/Frontend/Shortcode.php:109
msgid "Pick a date"
msgstr "Wybierz datę"

#: includes/Frontend/Shortcode.php:110
msgid "Today"
msgstr "Dzisiaj"

#: includes/Frontend/Shortcode.php:111
msgid "Yesterday"
msgstr "Wczoraj"

#: includes/Frontend/Shortcode.php:112
msgid "A week ago"
msgstr "Tydzień temu"

#: includes/Frontend/Shortcode.php:113
msgid "Loading exchange rates…"
msgstr "Ładowanie kursów walut…"

#: includes/Frontend/Shortcode.php:114
msgid "No exchange rates are available for the selected date."
msgstr "Brak kursów walut dla wybranej daty."

#: includes/Frontend/Shortcode.php:115
msgid "Exchange rates could not be loaded. Please try again later."
msgstr "Nie udało się pobrać kursów walut. Spróbuj ponownie później."

#. translators: 1: NBP table number, 2: effective date.
#: includes/Frontend/Shortcode.php:117
#, php-format
msgid "NBP table %1$s, effective %2$s"
msgstr "Tabela NBP nr %1$s z dnia %2$s"

#: includes/NbpClient.php:73
msgid "The date must be a valid past date in YYYY-MM-DD format."
msgstr "Data musi być w formacie RRRR-MM-DD i nie może być późniejsza niż dzisiejsza."

#: includes/NbpClient.php:153
msgid "Could not connect to the NBP API."
msgstr "Nie udało się połączyć z API NBP."

#: includes/NbpClient.php:166
msgid "NBP has not published table C for the selected date."
msgstr "NBP nie opublikował tabeli C dla wybranej daty."

#: includes/NbpClient.php:174
msgid "The NBP API returned an unexpected response."
msgstr "API NBP zwróciło nieoczekiwaną odpowiedź."

#: includes/NbpClient.php:187
msgid "The NBP API returned malformed data."
msgstr "API NBP zwróciło nieprawidłowe dane."

#: includes/Plugin.php:124
msgid "Settings"
msgstr "Ustawienia"

#: includes/Settings.php:82
msgid "General"
msgstr "Ogólne"

#: includes/Settings.php:83
msgid "Appearance"
msgstr "Wygląd"

#: includes/Settings.php:84
msgid "Advanced"
msgstr "Zaawansowane"

#: includes/Settings.php:97
msgid "Table heading"
msgstr "Nagłówek tabeli"

#: includes/Settings.php:98
msgid "Text displayed above the exchange rates table. Leave empty to use the default heading."
msgstr "Tekst wyświetlany nad tabelą kursów walut. Pozostaw puste, aby użyć domyślnego nagłówka."

#: includes/Settings.php:102
msgid "Currencies"
msgstr "Waluty"

#: includes/Settings.php:103
msgid "Currencies shown in the table, in the order they are published by NBP."
msgstr "Waluty wyświetlane w tabeli, w kolejności publikacji przez NBP."

#: includes/Settings.php:107
msgid "Accent colour"
msgstr "Kolor akcentu"

#: includes/Settings.php:108
msgid "Top border of the table header."
msgstr "Górna krawędź nagłówka tabeli."

#: includes/Settings.php:112
msgid "Heading colour"
msgstr "Kolor nagłówka"

#: includes/Settings.php:113
msgid "Colour of the table heading."
msgstr "Kolor nagłówka tabeli."

#: includes/Settings.php:117
msgid "Rate text colour"
msgstr "Kolor kursów"

#: includes/Settings.php:118
msgid "Colour of the buy and sell rates."
msgstr "Kolor kursów kupna i sprzedaży."

#: includes/Settings.php:122
msgid "Striped row colour"
msgstr "Kolor tła co drugiego wiersza"

#: includes/Settings.php:123
msgid "Background of every other table row."
msgstr "Tło co drugiego wiersza tabeli."

#: includes/Settings.php:127
msgid "Debug messages"
msgstr "Komunikaty debugowania"

#: includes/Settings.php:128
msgid "Log diagnostic messages to the browser console."
msgstr "Zapisuj komunikaty diagnostyczne w konsoli przeglądarki."

#: includes/Settings.php:132
msgid "Remove data on uninstall"
msgstr "Usuń dane przy odinstalowaniu"

#: includes/Settings.php:133
msgid "Delete the plugin settings from the database when the plugin is uninstalled."
msgstr "Usuń ustawienia wtyczki z bazy danych podczas odinstalowywania wtyczki."

#. translators: %s: setting key.
